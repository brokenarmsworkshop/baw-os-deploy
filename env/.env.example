# BAW OS — Configuration de déploiement modèle
#
# Copier ce fichier vers .env puis compléter les secrets.
# Le fichier .env réel ne doit jamais être ajouté à Git.

COMPOSE_PROJECT_NAME=baw-os

BAW_ENV=development

POSTGRES_DB=baw_os
POSTGRES_USER=baw_os
POSTGRES_PASSWORD=CHANGE_ME

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

TZ=Europe/Paris
GENERIC_TIMEZONE=Europe/Paris
